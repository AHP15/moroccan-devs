# ---------------------------------------------------------------------------
# Server-side only. NEVER prefix these with PUBLIC_ — Astro inlines any PUBLIC_
# variable into the built site, so a PUBLIC_ key ends up published to the web.
# ---------------------------------------------------------------------------

# Used by tools/rank-tracker. Not read by the site build at all.
SERPAPI_KEY=

# ---------------------------------------------------------------------------
# Browser-exposed by design. PUBLIC_ is correct for everything below.
# ---------------------------------------------------------------------------

# Analytics (Umami cloud or self-hosted). Leave blank to disable.
PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
PUBLIC_UMAMI_ID=

# Newsletter (Buttondown). Leave blank to render the form as a mailto fallback.
PUBLIC_BUTTONDOWN_USER=

# Giscus comments (Tier 1 — leave blank for now)
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY_ID=
