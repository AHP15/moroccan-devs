---
import { SITE, NAV_AR, LANG_SWITCH } from '~/consts';
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';

interface Props {
  /** The language of the page being rendered, so the switcher can offer the other one. */
  lang?: 'ar' | 'en';
}
const { lang = 'ar' } = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const otherLang = LANG_SWITCH[lang];
---

{/*
  One row on tablet and up. On a phone the four destinations will not fit beside the
  wordmark and the theme toggle, so the nav wraps onto a second line rather than being
  hidden behind a menu button — every destination stays one tap away. `order` does the
  rearranging so the nav is only written once.
*/}
<header class="sticky top-0 z-40 border-b border-[var(--border)] bg-[color-mix(in_oklab,var(--bg)_88%,transparent)] backdrop-blur-md">
  <div class="mx-auto flex max-w-3xl flex-wrap items-center gap-x-5 gap-y-1 px-5 py-2.5 sm:h-16 sm:flex-nowrap sm:py-0">
    <a href="/" class="group order-1 flex items-center gap-2.5 py-1 font-bold text-[var(--fg)] no-underline">
      <Logo size={28} class="shrink-0 text-[var(--accent)] transition-transform group-hover:rotate-45 motion-reduce:transition-none sm:size-[30px]" />
      <span class="text-[17px] tracking-tight">{SITE.name}</span>
    </a>

    <ThemeToggle class="order-2 ms-auto sm:order-3 sm:ms-0" />

    {/* Bleeds into the container padding so the row can scroll edge to edge if a
        translation ever makes the labels wider than the viewport. */}
    <nav
      class="order-3 -mx-5 flex w-full items-center gap-0.5 overflow-x-auto px-5 pb-0.5 text-[13px] sm:order-2 sm:mx-0 sm:w-auto sm:flex-1 sm:gap-1 sm:overflow-visible sm:px-0 sm:pb-0 sm:text-sm"
      aria-label="التنقّل الرئيسي"
    >
      {NAV_AR.map((item) => (
        <a
          href={item.href}
          class:list={[
            'shrink-0 rounded-lg px-2 py-1.5 no-underline transition-colors sm:px-2.5',
            isActive(item.href)
              ? 'bg-[var(--accent-soft)] font-semibold text-[var(--accent)]'
              : 'text-[var(--fg-muted)] hover:text-[var(--fg)]',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}

      {/* Separated from the destinations above, because it switches language rather
          than navigating somewhere new. `lang` and `hreflang` matter here: without
          them a screen reader announces 'English' in an Arabic voice, and 'العربية'
          in an English one. */}
      <a
        href={otherLang.href}
        lang={otherLang.lang}
        hreflang={otherLang.lang}
        dir={otherLang.lang === 'ar' ? 'rtl' : 'ltr'}
        title={otherLang.title}
        data-umami-event={`lang-switch-${otherLang.lang}`}
        class="ms-0.5 shrink-0 rounded-lg border border-[var(--border)] px-2 py-1.5 text-[var(--fg-muted)] no-underline transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)] sm:ms-1 sm:px-2.5"
      >{otherLang.label}</a>
    </nav>
  </div>
</header>
