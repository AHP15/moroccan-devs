---
import { SITE, NAV_AR } from '~/consts';
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-[var(--border)] bg-[color-mix(in_oklab,var(--bg)_88%,transparent)] backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-3xl items-center gap-5 px-5">
    <a href="/" class="group flex items-center gap-2.5 font-bold text-[var(--fg)] no-underline">
      <Logo size={30} class="text-[var(--accent)] transition-transform group-hover:rotate-45 motion-reduce:transition-none" />
      <span class="text-[17px] tracking-tight">{SITE.name}</span>
    </a>

    <nav class="flex flex-1 items-center gap-1 text-sm" aria-label="التنقّل الرئيسي">
      {NAV_AR.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-lg px-2.5 py-1.5 no-underline transition-colors',
            isActive(item.href)
              ? 'bg-[var(--accent-soft)] font-semibold text-[var(--accent)]'
              : 'text-[var(--fg-muted)] hover:text-[var(--fg)]',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <ThemeToggle />
  </div>
</header>
