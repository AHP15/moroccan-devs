---
/**
 * The MoroccanDevs mark: a zellij eight-point star (khatam) with an angle bracket cut
 * out of it — the Moroccan tile motif carrying the code half of the name. The bracket
 * points left because the site reads right-to-left; in Arabic that is "forward".
 *
 * The star takes `currentColor`, so callers set the colour with a text class and the
 * mark follows the theme. The bracket is painted in `--bg` so it stays a true knockout
 * in both light and dark.
 */
interface Props {
  /** Rendered edge length in px. The star reads down to 16. */
  size?: number;
  class?: string;
}

const { size = 32, class: className } = Astro.props;

/**
 * Octagram {8/2}: sixteen vertices alternating between the point radius (14.2) and the
 * inner radius (0.7654 × that), on a 32×32 grid. Stroking it in its own colour with a
 * round linejoin softens all sixteen corners at once, which is what stops the points
 * from vanishing at small sizes.
 */
const STAR =
  'M30.2 16 26.041 20.159 26.041 26.041 20.159 26.041 16 30.2 11.841 26.041 5.959 26.041 5.959 20.159 1.8 16 5.959 11.841 5.959 5.959 11.841 5.959 16 1.8 20.159 5.959 26.041 5.959 26.041 11.841Z';
---

<svg
  viewBox="0 0 32 32"
  width={size}
  height={size}
  class={className}
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path d={STAR} fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
  <path
    d="M18.4 10.9 11.8 16 18.4 21.1"
    stroke="var(--bg)"
    stroke-width="3.4"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
