---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import PostLayout from '~/layouts/PostLayout.astro';
import { getPublishedPosts, readingTime } from '~/lib/posts';

export const getStaticPaths = async () => {
  const posts = await getPublishedPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // `posts` is newest-first, so the newer neighbour sits at the lower index.
      next: posts[i - 1] ? { id: posts[i - 1].id, title: posts[i - 1].data.title } : undefined,
      prev: posts[i + 1] ? { id: posts[i + 1].id, title: posts[i + 1].data.title } : undefined,
    },
  }));
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post, prev, next } = Astro.props as Props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} readingTime={readingTime(post.body)} prev={prev} next={next}>
  <Content />
</PostLayout>
